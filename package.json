{
  "name": "farmos-mobile",
  "version": "0.2.19",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:emu": "expo start --localhost --android",
    "android:dev": "expo start --dev-client --android",
    "android:build": "expo run:android",
    "android:split": "bash scripts/dev-android.sh",
    "build:android:dev": "bash scripts/build-android.sh dev",
    "build:android:uat": "bash scripts/build-android.sh uat",
    "build:android:prod": "bash scripts/build-android.sh prod",
    "build:android:light": "make android-light",
    "ios": "expo run:ios",
    "ios:split": "bash scripts/dev-ios.sh",
    "web": "expo start --web",
    "prebuild": "expo prebuild --platform all --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "ios:open": "open ios/FarmOS.xcworkspace",
    "android:open": "open -a 'Android Studio' android",
    "tokens:gen": "node --import tsx scripts/oklch-to-hex.ts",
    "lint": "expo lint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@react-navigation/bottom-tabs": "^7.15.11",
    "@react-navigation/native": "^7.2.2",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/query-sync-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^26.0.8",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.6",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "culori": "^4.0.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
