# Example env file. Copy to `.env` for local dev (`npm run start` / `npm run android`).
# Per-environment release builds are driven by .env.development / .env.uat / .env.production
# via `scripts/build-android.sh dev|uat|prod` — see README for details.

# Pick ONE EXPO_PUBLIC_API_URL below for your local `.env`.

# --- Development (Vercel preview) ---
EXPO_PUBLIC_API_URL=https://farm-management-api-dev.vercel.app

# --- UAT ---
# EXPO_PUBLIC_API_URL=https://farm-management-api-uat.vercel.app

# --- Production ---
# EXPO_PUBLIC_API_URL=https://farm-management-api.vercel.app

# --- Local backend (Go API on your machine) ---
# - iOS simulator: localhost is fine.
# - Android emulator: keep "localhost" here — the app maps it to 10.0.2.2 at runtime.
# - Physical phone (iOS or Android): set to http://<your-mac-lan-ip>:8080 (same Wi-Fi as the phone).
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Metro / packager host (only when the device cannot use localhost for JS):
# Physical iPhone or Android phone over Wi-Fi: uncomment and set your Mac's LAN IP.
#   ip: System Settings → Network, or: ipconfig getifaddr en0
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.10
